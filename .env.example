# IBM Watson ML / Cloud
# Create an IBM Cloud API key and set it here.
# DO NOT commit your real .env file.
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here

# Server
PORT=3000
NODE_ENV=development

# Optional: IBM scoring/model configuration overrides
# (Keep defaults if you are using the provided IBM Watson ML deployment.)
IBM_AUTH_URL=https://iam.cloud.ibm.com/identity/token
IBM_SCORING_URL=https://au-syd.ml.cloud.ibm.com/ml/v4/deployments/019e9206-04c4-7346-ab4a-90e04f7ef203/predictions?version=2021-05-01

